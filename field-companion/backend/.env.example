# Field Companion Backend

# LLM
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma4:e4b

# Region (bounding box: min_lat,min_lon,max_lat,max_lon)
# Default: India (approximate)
REGION_BBOX=6.5,68.1,35.7,97.4

# Database
DB_PATH=./data/field_companion.db

# Audio
AUDIO_MAX_DURATION=30

# TTS (piper or say)
TTS_ENGINE=say
